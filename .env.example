# ------------------------------------------------------------------------------
# Acrely — environment configuration.
# Copy this file to .env (not committed) and run `./scripts/init.sh` to fill in
# the generated secret values (JWT_SECRET, ANON_KEY, SERVICE_ROLE_KEY).
# ------------------------------------------------------------------------------

# ---- Postgres ----
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432

# ---- JWT / API keys ----
# JWT_SECRET must be at least 32 chars. init.sh will generate one if missing.
JWT_SECRET=
JWT_EXPIRY=3600

# The anon key and service role key are JWTs signed with JWT_SECRET.
# init.sh will generate and print them.
ANON_KEY=
SERVICE_ROLE_KEY=

# ---- App / branding ----
APP_NAME=Acrely
COMPANY_NAME=Kresta Infra & Developers

# ---- URLs ----
# SITE_URL: how the browser reaches the Next.js app.
SITE_URL=http://localhost:3000

# API_EXTERNAL_URL: how the browser reaches the Supabase API (Kong).
API_EXTERNAL_URL=http://localhost:8000

# Additional redirect URLs GoTrue will accept (comma separated).
ADDITIONAL_REDIRECT_URLS=http://localhost:3000,http://localhost:3000/auth/callback

# Disable new-user signup. For single-user mode leave this false until first
# login, then flip to true.
DISABLE_SIGNUP=false

# ---- SMTP for auth emails (OTP / magic links) ----
# In dev, leave these pointing at the inbucket email catcher (view at :9000).
# In production, set real SMTP credentials.
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=inbucket
SMTP_PORT=2500
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Acrely

# ---- Ports (host-side) ----
WEB_PORT=3000
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
STUDIO_PORT=3001
INBUCKET_PORT=9000

# ---- Supabase Studio auth ----
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=change-me-studio-password

# ---- Optional: Cloudflare Tunnel for mobile access ----
# Leave blank unless using `docker compose --profile tunnel up`.
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Backups ----
BACKUP_DIR=/backups/acrely
