# Line-endings policy for cross-platform builds.
# Shell scripts and container-mounted configs MUST be LF — Git for Windows
# would otherwise rewrite them to CRLF on checkout, which breaks bash `eval`,
# `psql -f`, and Postgres init scripts.

*               text=auto eol=lf
*.sh            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.sql           text eol=lf
*.conf          text eol=lf
Dockerfile      text eol=lf
.env.example    text eol=lf

# Known binaries
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.pdf           binary
*.woff          binary
*.woff2         binary
